{
  "schema_version": "1.0.0",
  "as_of": "2026-11-15",
  "name": "Racing Hot Pots race-strength classification reference",
  "scope": "UK/Ireland only; historic-aware",
  "purpose": "Structured pre-race categorical strength prior; NOT official universal numeric ranking",
  "score_semantics": "provisional ordinal feature from 0 to 100, NOT a calibrated rating nor winning probability",
  "principles": [
    "Pattern/Listed grades rank highest within their own Flat or National Hunt discipline",
    "Handicap versus non-handicap is a separate categorical feature; no assumption of equal ability between them",
    "GB Class 1 contains multiple sublevels; never overwrite a known Group/Grade/Listed label with generic class",
    "Irish 0-100/0-140 denote handicap entry rating bands, not Pattern grades",
    "Ground race tier in event DATE and official metadata; race labels can change over seasons",
    "Use pre-race field official ratings as independent measures of opposition strength; no post-race ratings, finishing positions or SP for prediction",
    "Unknown classifications return null and audit reason"
  ],
